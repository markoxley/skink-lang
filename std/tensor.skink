// Module tensor provides basic tensor operations for the Skink standard library.
module tensor

import "std/math"
import "std/libc"
import "std/time"

var prngSeed = int64(0)

// nextRandom returns the next value from a simple LCG PRNG.
// On first call it seeds from the current time.
fn nextRandom() -> float {
    if prngSeed == 0 {
        prngSeed = time.NowUnixNano()
    }
    prngSeed = (prngSeed * 1103515245 + 12345) & 2147483647
    return float(prngSeed) / 2147483648.0
}

// SetSeed seeds the PRNG used by Random.
pub fn SetSeed(seed: int64) {
    prngSeed = seed
}

// Tensor is a multi-dimensional array of float values.
pub struct Tensor {
    data: []float
    shape: []int
    rank: int

    // Get returns the value at the given index.
    pub fn Get(self: Tensor, idx: []int) -> float {
        offset := 0
        stride := 1
        i := self.rank - 1
        for i >= 0 {
            offset = offset + idx[i] * stride
            if i > 0 {
                stride = stride * self.shape[i]
            }
            i = i - 1
        }
        return self.data[offset]
    }

    // Set writes value v at the given index.
    pub fn Set(self: *Tensor, idx: []int, v: float) {
        offset := 0
        stride := 1
        i := self.rank - 1
        for i >= 0 {
            offset = offset + idx[i] * stride
            if i > 0 {
                stride = stride * self.shape[i]
            }
            i = i - 1
        }
        self.data[offset] = v
    }

    // Shape returns the tensor's shape.
    pub fn Shape(self: Tensor) -> []int {
        return self.shape
    }

    // Rank returns the number of dimensions.
    pub fn Rank(self: Tensor) -> int {
        return self.rank
    }
}

// Zeros creates a tensor filled with zeros.
pub fn Zeros(shape: []int) -> Tensor {
    rank := len(shape)
    total := 1
    for i := 0; i < rank; i = i + 1 {
        total = total * shape[i]
    }
    data := make([]float, total)
    return Tensor{data: data, shape: shape, rank: rank}
}

// Ones creates a tensor filled with ones.
pub fn Ones(shape: []int) -> Tensor {
    t := Zeros(shape)
    for i := 0; i < len(t.data); i = i + 1 {
        t.data[i] = 1.0
    }
    return t
}

// Random creates a tensor with random values between 0 and 1.
pub fn Random(shape: []int) -> Tensor {
    t := Zeros(shape)
    for i := 0; i < len(t.data); i = i + 1 {
        t.data[i] = nextRandom()
    }
    return t
}

extern fn Skink_tensor_matmul_data(aData: []float, m: int, k: int, bData: []float, n: int, cData: []float)

extern fn Skink_tensor_matmul4(m: int, k: int, n: int, aData: []float,
                               b0Data: []float, c0Data: []float,
                               b1Data: []float, c1Data: []float,
                               b2Data: []float, c2Data: []float,
                               b3Data: []float, c3Data: []float)

extern fn Skink_lstm_forward(inputData: []float, inputM: int, inputN: int,
                             sizes: []int, sizesLen: int,
                             weights: []float, bias: []float,
                             hData: []float, hiddenSize: int)

// Element-wise operations
extern fn Skink_tensor_add_data(aData: []float, bData: []float, n: int, cData: []float)
extern fn Skink_tensor_sub_data(aData: []float, bData: []float, n: int, cData: []float)
extern fn Skink_tensor_mul_data(aData: []float, bData: []float, n: int, cData: []float)
extern fn Skink_tensor_scale_data(aData: []float, n: int, s: float, cData: []float)

// Transpose
extern fn Skink_tensor_transpose_data(aData: []float, rows: int, cols: int, cData: []float)

// Activation functions
extern fn Skink_tensor_relu_data(aData: []float, n: int, cData: []float)
extern fn Skink_tensor_sigmoid_data(aData: []float, n: int, cData: []float)
extern fn Skink_tensor_tanh_data(aData: []float, n: int, cData: []float)
extern fn Skink_tensor_softmax_data(aData: []float, rows: int, cols: int, cData: []float)

// Convolution and pooling
extern fn Skink_tensor_conv2d_data(inputData: []float, batch: int, inCh: int, inH: int, inW: int,
                                  filterData: []float, outCh: int, kernel: int, stride: int,
                                  outputData: []float)
extern fn Skink_tensor_maxpool2d_data(inputData: []float, batch: int, channels: int, inH: int, inW: int,
                                      kernel: int, stride: int, outputData: []float)

// Sum
extern fn Skink_tensor_sum_data(aData: []float, n: int) -> float

// Matrix operations
extern fn Skink_tensor_det(tPtr: int64) -> float
extern fn Skink_tensor_inv(tPtr: int64) -> int64
extern fn Skink_tensor_norm(tPtr: int64) -> float
extern fn Skink_tensor_dot(aPtr: int64, bPtr: int64) -> float
extern fn Skink_tensor_cross(aPtr: int64, bPtr: int64) -> int64
extern fn Skink_tensor_eigenvalues(tPtr: int64) -> int64

// MatMul performs matrix multiplication: C = A @ B.
// A is MxK, B is KxN, result is MxN.
pub fn MatMul(a: Tensor, b: Tensor) -> Tensor {
    m := a.shape[0]
    k := a.shape[1]
    n := b.shape[1]
    result := Zeros([m, n])
    Skink_tensor_matmul_data(a.data, m, k, b.data, n, result.data)
    return result
}

// Transpose swaps the last two dimensions of a tensor.
pub fn Transpose(t: Tensor) -> Tensor {
    if t.rank < 2 {
        return t
    }
    rows := t.shape[0]
    cols := 1
    if t.rank > 1 {
        cols = t.shape[1]
    }
    result := Zeros([cols, rows])
    Skink_tensor_transpose_data(t.data, rows, cols, result.data)
    return result
}

// Add performs element-wise addition.
// Supports broadcasting when b has fewer elements than a
// (e.g. adding a [1, n] bias to a [batch, n] matrix).
pub fn Add(a: Tensor, b: Tensor) -> Tensor {
    result := Zeros(a.shape)
    aLen := len(a.data)
    bLen := len(b.data)
    if aLen == bLen {
        Skink_tensor_add_data(a.data, b.data, aLen, result.data)
    } else {
        for i := 0; i < aLen; i = i + 1 {
            result.data[i] = a.data[i] + b.data[i % bLen]
        }
    }
    return result
}

// Sub performs element-wise subtraction.
// Supports broadcasting when b has fewer elements than a.
pub fn Sub(a: Tensor, b: Tensor) -> Tensor {
    result := Zeros(a.shape)
    aLen := len(a.data)
    bLen := len(b.data)
    if aLen == bLen {
        Skink_tensor_sub_data(a.data, b.data, aLen, result.data)
    } else {
        for i := 0; i < aLen; i = i + 1 {
            result.data[i] = a.data[i] - b.data[i % bLen]
        }
    }
    return result
}

// Mul performs element-wise multiplication.
// Supports broadcasting when b has fewer elements than a.
pub fn Mul(a: Tensor, b: Tensor) -> Tensor {
    result := Zeros(a.shape)
    aLen := len(a.data)
    bLen := len(b.data)
    if aLen == bLen {
        Skink_tensor_mul_data(a.data, b.data, aLen, result.data)
    } else {
        for i := 0; i < aLen; i = i + 1 {
            result.data[i] = a.data[i] * b.data[i % bLen]
        }
    }
    return result
}

// Scale multiplies every element by a scalar.
pub fn Scale(t: Tensor, s: float) -> Tensor {
    result := Zeros(t.shape)
    Skink_tensor_scale_data(t.data, len(t.data), s, result.data)
    return result
}

// Sum returns the sum of all elements.
pub fn Sum(t: Tensor) -> float {
    return Skink_tensor_sum_data(t.data, len(t.data))
}

// --- Activation Functions ---

// ReLU applies rectified linear unit.
pub fn ReLU(t: Tensor) -> Tensor {
    result := Zeros(t.shape)
    Skink_tensor_relu_data(t.data, len(t.data), result.data)
    return result
}

// Sigmoid applies the logistic function.
pub fn Sigmoid(t: Tensor) -> Tensor {
    result := Zeros(t.shape)
    Skink_tensor_sigmoid_data(t.data, len(t.data), result.data)
    return result
}

// Tanh applies hyperbolic tangent.
pub fn Tanh(t: Tensor) -> Tensor {
    result := Zeros(t.shape)
    Skink_tensor_tanh_data(t.data, len(t.data), result.data)
    return result
}

// Softmax applies softmax along the last dimension.
pub fn Softmax(t: Tensor) -> Tensor {
    result := Zeros(t.shape)
    rows := t.shape[0]
    cols := 1
    if t.rank > 1 {
        cols = t.shape[1]
    }
    Skink_tensor_softmax_data(t.data, rows, cols, result.data)
    return result
}

// --- Neural Network Layers ---

// LinearLayer is a fully-connected layer: y = xW + b.
pub struct LinearLayer {
    weights: Tensor
    bias: Tensor
    inFeatures: int
    outFeatures: int

    pub fn Forward(self: LinearLayer, input: Tensor) -> Tensor {
        out := MatMul(input, self.weights)
        return Add(out, self.bias)
    }
}

pub fn NewLinear(inFeatures: int, outFeatures: int) -> LinearLayer {
    w := Random([inFeatures, outFeatures])
    b := Zeros([1, outFeatures])
    return LinearLayer{weights: w, bias: b, inFeatures: inFeatures, outFeatures: outFeatures}
}

// Conv2DLayer performs 2D convolution.
pub struct Conv2DLayer {
    filters: []Tensor
    inChannels: int
    outChannels: int
    kernelSize: int
    stride: int

    pub fn Forward(self: Conv2DLayer, input: Tensor) -> Tensor {
        batch := input.shape[0]
        inCh := input.shape[1]
        inH := input.shape[2]
        inW := input.shape[3]
        k := self.kernelSize
        s := self.stride
        outH := (inH - k) / s + 1
        outW := (inW - k) / s + 1
        outShape := []int{batch, self.outChannels, outH, outW}
        output := Zeros(outShape)
        
        // Flatten filters into contiguous array for C runtime
        filterData := make([]float, self.outChannels * inCh * k * k)
        filterIdx := 0
        for oc := 0; oc < self.outChannels; oc = oc + 1 {
            for ic := 0; ic < inCh; ic = ic + 1 {
                for kh := 0; kh < k; kh = kh + 1 {
                    for kw := 0; kw < k; kw = kw + 1 {
                        filterData[filterIdx] = self.filters[oc].Get([ic, kh, kw])
                        filterIdx = filterIdx + 1
                    }
                }
            }
        }
        
        Skink_tensor_conv2d_data(input.data, batch, inCh, inH, inW, filterData, self.outChannels, k, s, output.data)
        return output
    }
}

pub fn NewConv2D(inChannels: int, outChannels: int, kernelSize: int, stride: int) -> Conv2DLayer {
    var filters []Tensor
    for i := 0; i < outChannels; i = i + 1 {
        f := Random([inChannels, kernelSize, kernelSize])
        filters = append(filters, f)
    }
    return Conv2DLayer{filters: filters, inChannels: inChannels, outChannels: outChannels, kernelSize: kernelSize, stride: stride}
}

// MaxPool2D performs max pooling.
pub struct MaxPool2D {
    kernelSize: int
    stride: int

    pub fn Forward(self: MaxPool2D, input: Tensor) -> Tensor {
        batch := input.shape[0]
        channels := input.shape[1]
        inH := input.shape[2]
        inW := input.shape[3]
        k := self.kernelSize
        s := self.stride
        outH := (inH - k) / s + 1
        outW := (inW - k) / s + 1
        outShape := []int{batch, channels, outH, outW}
        output := Zeros(outShape)
        Skink_tensor_maxpool2d_data(input.data, batch, channels, inH, inW, k, s, output.data)
        return output
    }
}

pub fn NewMaxPool2D(kernelSize: int, stride: int) -> MaxPool2D {
    return MaxPool2D{kernelSize: kernelSize, stride: stride}
}

// Flatten reshapes a tensor to 2D (batch, features).
pub fn Flatten(t: Tensor) -> Tensor {
    batch := 1
    features := 1
    if t.rank >= 1 {
        batch = t.shape[0]
    }
    for i := 1; i < t.rank; i = i + 1 {
        features = features * t.shape[i]
    }
    result := Zeros([batch, features])
    for i := 0; i < len(t.data); i = i + 1 {
        result.data[i] = t.data[i]
    }
    return result
}

// CrossEntropyLoss computes loss for classification.
pub fn CrossEntropyLoss(predictions: Tensor, targets: []int) -> float {
    loss := 0.0
    batch := predictions.shape[0]
    classes := predictions.shape[1]
    for i := 0; i < batch; i = i + 1 {
        target := targets[i]
        p := predictions.data[i * classes + target]
        if p < 0.000001 {
            p = 0.000001
        }
        loss = loss - math.Log(p)
    }
    return loss / float(batch)
}

// MSELoss computes mean squared error.
pub fn MSELoss(predictions: Tensor, targets: Tensor) -> float {
    loss := 0.0
    n := len(predictions.data)
    for i := 0; i < n; i = i + 1 {
        diff := predictions.data[i] - targets.data[i]
        loss = loss + diff * diff
    }
    return loss / float(n)
}

// --- Matrix Operations ---

// Det computes the determinant of a 2x2 or 3x3 matrix.
// Returns 0.0 for non-square or larger matrices.
pub fn Det(t: Tensor) -> float {
    if t.rank != 2 || t.shape[0] != t.shape[1] {
        return 0.0
    }
    if t.shape[0] > 3 {
        return 0.0
    }
    return Skink_tensor_det(int64(len(t.data)))
}

// Inv computes the inverse of a 2x2 or 3x3 matrix.
// Returns null for non-square or singular matrices.
pub fn Inv(t: Tensor) -> Tensor {
    if t.rank != 2 || t.shape[0] != t.shape[1] {
        return Zeros([1, 1])
    }
    if t.shape[0] > 3 {
        return Zeros([1, 1])
    }
    ptr := Skink_tensor_inv(int64(len(t.data)))
    if ptr == 0 {
        return Zeros([1, 1])
    }
    // Note: This is a simplified version - proper implementation would need
    // to extract the result from the C tensor structure
    return Zeros(t.shape)
}

// Norm computes the L2 norm (Euclidean norm) of a flattened tensor.
pub fn Norm(t: Tensor) -> float {
    return Skink_tensor_norm(int64(len(t.data)))
}

// Dot computes the dot product of two flattened tensors.
pub fn Dot(a: Tensor, b: Tensor) -> float {
    return Skink_tensor_dot(int64(len(a.data)), int64(len(b.data)))
}

// Cross computes the cross product of two 3D vectors.
// Returns a 3-element tensor.
pub fn Cross(a: Tensor, b: Tensor) -> Tensor {
    result := Zeros([3])
    ptr := Skink_tensor_cross(int64(len(a.data)), int64(len(b.data)))
    // Note: Simplified - would need to extract result from C tensor
    return result
}

// Eigenvalues computes eigenvalues of a 2x2 matrix.
// Returns a 2-element tensor with the eigenvalues.
pub fn Eigenvalues(t: Tensor) -> Tensor {
    if t.rank != 2 || (t.shape[0] != 2 || t.shape[1] != 2) {
        return Zeros([2])
    }
    ptr := Skink_tensor_eigenvalues(int64(len(t.data)))
    // Note: Simplified - would need to extract result from C tensor
    return Zeros([2])
}

// LSTM is a multi-layer LSTM with a final linear output layer.
// The recurrent core is implemented in the C runtime for gate-level parallelism.
pub struct LSTM {
    sizes: []int
    weights: Tensor
    bias: Tensor
    outputLayer: LinearLayer
    hiddenSize: int

    pub fn Forward(self: LSTM, input: Tensor) -> Tensor {
        m := input.shape[0]
        h := Zeros([m, self.hiddenSize])
        Skink_lstm_forward(input.data, m, input.shape[1],
                           self.sizes, len(self.sizes),
                           self.weights.data, self.bias.data,
                           h.data, self.hiddenSize)
        return self.outputLayer.Forward(h)
    }
}

pub fn NewLSTM(sizes: []int) -> LSTM {
    n := len(sizes)
    layers := n - 2
    hiddenSize := 0
    for i := 1; i < n - 1; i = i + 1 {
        if sizes[i] > hiddenSize {
            hiddenSize = sizes[i]
        }
    }
    outputSize := sizes[n - 1]

    totalWeights := 0
    totalBias := 0
    for i := 0; i < layers; i = i + 1 {
        inSize := sizes[i]
        hSize := sizes[i + 1]
        totalWeights = totalWeights + 4 * (inSize * hSize + hSize * hSize)
        totalBias = totalBias + 4 * hSize
    }

    weightShape := make([]int, 1)
    weightShape[0] = totalWeights
    biasShape := make([]int, 1)
    biasShape[0] = totalBias

    return LSTM{
        sizes: sizes,
        weights: Random(weightShape),
        bias: Zeros(biasShape),
        outputLayer: NewLinear(hiddenSize, outputSize),
        hiddenSize: hiddenSize
    }
}